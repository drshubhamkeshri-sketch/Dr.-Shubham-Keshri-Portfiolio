{
  "name": "shubham-keshri-portfolio",
  "version": "1.0.0",
  "description": "Executive portfolio website for Dr. Shubham Keshri with separated backend (Render) and frontend (Vercel), MongoDB Atlas, and Cloudinary",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
