# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shubham_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shubham_keshri_portfolio

# Cloudinary Configuration
# Get these free from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
