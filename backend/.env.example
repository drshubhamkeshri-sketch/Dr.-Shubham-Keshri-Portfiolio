# Port configuration (Render assigns PORT automatically in production)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pwrupsh.mongodb.net/shubham_keshri_portfolio?retryWrites=true&w=majority&appName=Cluster0

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Frontend Client URL (Deployed on Vercel)
CLIENT_URL=https://drshubhamkeshri.vercel.app
FRONTEND_URL=https://drshubhamkeshri.vercel.app

# CORS Allowed Origins
CORS_ORIGIN=https://drshubhamkeshri.vercel.app,http://localhost:3000,http://localhost:5000,*

# Executive Admin Authentication Passkey
ADMIN_PASSKEY=keshri2026
